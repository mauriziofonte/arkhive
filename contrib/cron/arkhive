# Generated by arkhive schedule for /etc/arkhive/config
# Save as /etc/cron.d/arkhive (root:root, mode 0644). Logs: /var/log/arkhive.log
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ARKHIVE_LOCK_DIR=/run/arkhive
30 2 * * * root nice -n 10 /usr/local/bin/arkhive backup --config /etc/arkhive/config --log-file /var/log/arkhive.log >/dev/null 2>&1
30 5 * * 0 root nice -n 10 /usr/local/bin/arkhive maintain --config /etc/arkhive/config --log-file /var/log/arkhive.log >/dev/null 2>&1
30 5 * * 3 root nice -n 10 /usr/local/bin/arkhive drill --config /etc/arkhive/config --log-file /var/log/arkhive.log >/dev/null 2>&1
