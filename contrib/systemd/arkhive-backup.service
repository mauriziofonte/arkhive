# Generated by arkhive schedule for /etc/arkhive/config
[Unit]
Description=ArkHive backup
Documentation=https://github.com/mauriziofonte/arkhive
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
NotifyAccess=main
User=root
ExecStart=/usr/local/bin/arkhive backup --config /etc/arkhive/config
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=6h
PrivateTmp=true
NoNewPrivileges=true
