# Generated by arkhive schedule for /etc/arkhive/config
[Unit]
Description=ArkHive restore drill
Documentation=https://github.com/mauriziofonte/arkhive
Wants=network-online.target
After=network-online.target arkhive-backup.service arkhive-maintain.service
OnFailure=arkhive-failure@%n.service

[Service]
Type=oneshot
NotifyAccess=main
User=root
ExecStart=/usr/local/bin/arkhive drill --config /etc/arkhive/config
Nice=10
IOSchedulingClass=idle
CPUSchedulingPolicy=batch
TimeoutStartSec=3h
StateDirectory=arkhive
CacheDirectory=arkhive
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
