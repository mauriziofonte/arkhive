# Generated by arkhive schedule for /etc/arkhive/config
[Unit]
Description=ArkHive maintenance (retention, prune, check)
Documentation=https://github.com/mauriziofonte/arkhive
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/bin/arkhive maintain --config /etc/arkhive/config
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=12h
PrivateTmp=true
NoNewPrivileges=true
