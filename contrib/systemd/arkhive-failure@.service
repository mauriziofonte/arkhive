# Generated by arkhive schedule for /etc/arkhive/config
[Unit]
Description=ArkHive notification about the failed %i
Documentation=https://github.com/mauriziofonte/arkhive
After=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/bin/arkhive notify --failed-unit %i --config /etc/arkhive/config
SuccessExitStatus=3
TimeoutStartSec=10min
PrivateTmp=true
NoNewPrivileges=true
