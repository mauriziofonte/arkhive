{
    "name": "mfonte/arkhive",
    "description": "ArkHive is a disaster recovery and backup tool built with Laravel Zero. Designed to streamline and encrypt backups, ArkHive ensures that your critical data is safely vaulted and easily recoverable.",
    "keywords": [
        "backup",
        "encryption",
        "disaster recovery",
        "laravel zero"
    ],
    "homepage": "https://github.com/mauriziofonte/arkhive",
    "type": "project",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/mauriziofonte/arkhive/issues",
        "source": "https://github.com/mauriziofonte/arkhive"
    },
    "authors": [
        {
            "name": "Maurizio Fonte",
            "email": "fonte.maurizio@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel-zero/framework": "^13.0",
        "symfony/mailer": "^7.4",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "Mfonte\\Arkhive\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": [
        "arkhive"
    ]
}
